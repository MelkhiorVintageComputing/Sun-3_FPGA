wish7990: declare the status nets before their first use

xvlog (Vivado 2025.2) rejects a net used before its declaration:
  ERROR: [VRFC 10-2938] 'idon' is already implicitly declared on line 94
and likewise rxon, rint, rx_fifo_rd, tint and tx_done_s2.  Verilator and
Icarus accept it.  Their declaration lines move up to the top of the
module, unchanged.

Against Wish7990 5ec03d4.  To drop once fixed upstream.

--- a/src/wish7990.sv	2026-09-28 22:05:23.730808696 +0200
+++ b/src/wish7990.sv	2026-09-28 22:05:47.683341540 +0200
@@ -70,6 +70,15 @@
   // ---- the four registers and the address port ------------------------------
   logic [23:0] iadr;
   logic        init_pulse, strt, stop, tdmd, inea;
+  // Declared here rather than with the blocks that drive them: they are
+  // used earlier in the file, and xvlog will not take a use before the
+  // declaration.
+  logic        idon, merr_init;
+  logic        rxon, txon;
+  logic        rint, miss, merr_rx, rx_fault;
+  logic       rx_fifo_rd;
+  logic        tint, babl, merr_tx, tx_fault;
+  logic tx_done_s1, tx_done_s2;
 
   le_regs u_regs (
       .clk        (clk),
@@ -105,8 +114,6 @@
   );
 
   // ---- the initialisation block reader ---------------------------------------
-  logic        idon, merr_init;
-  logic        rxon, txon;
   logic [15:0] mode;
   logic [47:0] padr;
   logic [63:0] ladrf;
@@ -154,7 +161,6 @@
   );
 
   // ---- the receive front end, its clock crossing and its ring engine ---------
-  logic        rint, miss, merr_rx, rx_fault;
   logic        rxfe_wr, rxfe_full, rxfe_active;
   logic [11:0] rxfe_word;
   logic [15:0] rxfe_bytes;
@@ -214,7 +220,6 @@
   wire [11:0] rx_fifo_data  = lb_active ? lb_data  : rxf_data;
   assign      rxf_rd        = !lb_active && rx_fifo_rd;
   assign      lb_rd         =  lb_active && rx_fifo_rd;
-  logic       rx_fifo_rd;
 
   // Deep enough for the longest frame p. 24 allows back: "The received packet
   // can be up to 36 bytes (32 + 4 bytes CRC) when DTCR = 0", plus the word
@@ -264,7 +269,6 @@
   );
 
   // ---- the transmit ring engine ----------------------------------------------
-  logic        tint, babl, merr_tx, tx_fault;
   logic        tx_late;
   logic [3:0]  tx_retry_limit;
   logic        tx_ram_we;
@@ -330,7 +334,6 @@
   // done_o is produced in the PHY's transmit clock domain; two flops bring it
   // across.  go_i goes the other way and mii_tx synchronises it itself, which
   // is what makes the handshake four phase rather than a pulse either way.
-  logic tx_done_s1, tx_done_s2;
   always_ff @(posedge clk) begin
     if (rst) begin
       tx_done_s1 <= 1'b0;
